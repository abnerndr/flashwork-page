:{$PORT:3000} {
	root * /app/out
	encode gzip zstd

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
