# Copie este arquivo para .env. No Dokploy, defina as mesmas variáveis antes do build:
# o Next.js grava esses valores na página durante o `npm run build`.

# Repositório do Flashwork. Usado nos links de GitHub, código-fonte e documentação.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/abnerndr/flashwork

# Instalador Windows (EXE x64)
NEXT_PUBLIC_DOWNLOAD_WINDOWS_URL=https://github.com/abnerndr/flashwork/releases/download/0.1.0/Flashwork_0.1.0_x64-setup.exe

# Instalador macOS (DMG Intel x64)
NEXT_PUBLIC_DOWNLOAD_MACOS_URL=https://github.com/abnerndr/flashwork/releases/download/0.1.0/Flashwork_0.1.0_x64.dmg

# Instalador Linux (DEB x64)
NEXT_PUBLIC_DOWNLOAD_LINUX_URL=https://github.com/abnerndr/flashwork/releases/download/0.1.0/Flashwork_0.1.0_amd64.deb
